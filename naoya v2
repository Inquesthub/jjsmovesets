local function gmv() local m=pg:FindFirstChild("Main") or pg:FindFirstChild("MainGui") return m and m:FindFirstChild("Moveset",true) end

local function getNear(root,maxD)

    maxD=maxD or 60 local n,d=nil,math.huge

    for _,ec in ipairs(ch:GetChildren()) do if ec.Name~=pl.Name then local eh=ec:FindFirstChildOfClass("Humanoid") local er=ec:FindFirstChild("HumanoidRootPart") or ec:FindFirstChild("Torso") if eh and eh.Health>0 and er then local dd=(root.Position-er.Position).Magnitude if dd<d and dd<maxD then d=dd n=er end end end end

    return n

end

local function stopDashNow()

    isDash=false dashAA=false

    if dashT2 then dashT2:Stop(0.1) dashT2=nil end

    if rushBV then rushBV.Velocity=Vector3.new(0,0,0) rushBV:Destroy() rushBV=nil end

    lockedTarget=nil dashCD=true

    if rushCD then rushCD.Size=UDim2.new(1,0,1,0) rushCD.BackgroundColor3=Color3.fromRGB(0,180,255) rushCD.BackgroundTransparency=0.3 TS:Create(rushCD,TweenInfo.new(7,Enum.EasingStyle.Linear),{Size=UDim2.new(1,0,0,0)}):Play() end

    

end

local function music(tip)

    if not isMus then isMus=true if tip then tip.Text="Stop" end musS=Instance.new("Sound") musS.SoundId="rbxassetid://123462196064122" musS.Volume=5 musS.Parent=(pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")) or pg musS:Play()

    else isMus=false if tip then tip.Text="Play" end if musS then musS:Destroy() musS=nil end end

end

local function img(char)

    local m=Instance.new("Model",workspace)

    for _,p in ipairs(char:GetChildren()) do

        if not(p:IsA("BasePart") or p:IsA("MeshPart")) or p.Name:lower()=="humanoidrootpart" then continue end

        local c=p:Clone() c.Anchored=false c.CanCollide=false c.Massless=true c.CFrame=p.CFrame c.AssemblyLinearVelocity=p.AssemblyLinearVelocity*0.2 c.Transparency=0.6 c.Material=Enum.Material.Neon c.Color=DC

        if p.Name:lower():find("leg") then c.Transparency=0.5 Instance.new("PointLight",c).Color=DC end

        for _,ch2 in ipairs(c:GetChildren()) do if not ch2:IsA("PointLight") then ch2:Destroy() end end c.Parent=m

    end

    task.spawn(function() for i=1,7 do for _,p in ipairs(m:GetChildren()) do if p:IsA("BasePart") then pcall(function() p.Transparency=0.6+i/7*0.4 end) end end task.wait(0.03) end m:Destroy() end)

end

local function smoke(root)

    local p=Instance.new("Part",workspace) p.Anchored,p.CanCollide,p.Transparency=true,false,1 p.Size=Vector3.new(1,1,1) p.CFrame=root.CFrame*CFrame.new(0,-2,0)

    local e=Instance.new("ParticleEmitter",Instance.new("Attachment",p)) e.Color=ColorSequence.new(DC) e.LightEmission=0.5

    e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}) e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.5),NumberSequenceKeypoint.new(1,1)})

    e.Lifetime=NumberRange.new(0.2,0.4) e.Speed=NumberRange.new(1,3) e.Rate=0 e:Emit(8) task.delay(0.5,function() p:Destroy() end)

end

local function dash(cd)

    if isDash or dashCD then return end

    local char=ch:FindFirstChild(pl.Name) local root=char and char:FindFirstChild("HumanoidRootPart") local hum=char and char:FindFirstChildOfClass("Humanoid") if not root or not hum then return end

    isDash=true dashCD=true rushCD=cd
    task.delay(7,function() dashCD=false end) 
    if cd then cd.Size=UDim2.new(1,0,1,0) cd.BackgroundColor3=Color3.fromRGB(0,180,255) cd.BackgroundTransparency=0.3 TS:Create(cd,TweenInfo.new(7,Enum.EasingStyle.Linear),{Size=UDim2.new(1,0,0,0)}):Play() end

    task.spawn(function()

        local cam=workspace.CurrentCamera local fov=cam.FieldOfView local an=RS.Animations.Gojo.ShortVoid local anim=hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator")

        local t1=anim:LoadAnimation(an) t1.Priority=Enum.AnimationPriority.Action4 t1:Play(0) t1.TimePosition=3.56

        TS:Create(cam,TweenInfo.new(0.2),{FieldOfView=fov+40}):Play() task.wait(1.5) t1:Stop(0.1) TS:Create(cam,TweenInfo.new(0.1),{FieldOfView=fov}):Play()

        if not isDash then return end

        rushBV=Instance.new("BodyVelocity",root) rushBV.MaxForce=Vector3.new(1e6,0,1e6)

        if rushMode=="Lock" then

            lockedTarget=getNear(root,60)

            if lockedTarget then local dir=(lockedTarget.Position-root.Position)*Vector3.new(1,0,1) if dir.Magnitude>0 then root.CFrame=CFrame.new(root.Position,Vector3.new(lockedTarget.Position.X,root.Position.Y,lockedTarget.Position.Z)) rushBV.Velocity=dir.Unit*150 else rushBV.Velocity=root.CFrame.LookVector*Vector3.new(1,0,1)*150 end

            else rushBV.Velocity=root.CFrame.LookVector*Vector3.new(1,0,1)*150 end

        else lockedTarget=nil rushBV.Velocity=root.CFrame.LookVector*Vector3.new(1,0,1)*150 end

        local rs=Instance.new("Sound",root) rs.SoundId="rbxassetid://115962892067823" rs.Volume=5 rs:Play()

        dashT2=anim:LoadAnimation(an) dashT2.Priority=Enum.AnimationPriority.Action4 dashAA=true

        task.spawn(function() while dashAA do dashT2:Play(0) dashT2.TimePosition=8.34 while dashAA do if dashT2.TimePosition>=11.41 then dashT2:Stop(0) break end task.wait(0.03) end end end)

        task.spawn(function() while isDash do if not rs.IsPlaying then rs:Play() end task.wait(0.1) end rs:Stop() rs:Destroy() end)

        local et=tick()+5 local ai,sm=0,0

        while tick()<et and isDash do

            if rushMode=="Lock" then

                if not lockedTarget then lockedTarget=getNear(root,60) end

                if lockedTarget then local dir=(lockedTarget.Position-root.Position)*Vector3.new(1,0,1) if dir.Magnitude>0 then root.CFrame=CFrame.new(root.Position,Vector3.new(lockedTarget.Position.X,root.Position.Y,lockedTarget.Position.Z)) cam.CFrame=CFrame.new(cam.CFrame.Position,lockedTarget.Position) rushBV.Velocity=dir.Unit*150 end

                else if rushBV then rushBV.Velocity=root.CFrame.LookVector*Vector3.new(1,0,1)*150 end end

            else lockedTarget=nil if rushBV then rushBV.Velocity=root.CFrame.LookVector*Vector3.new(1,0,1)*150 end end

            if tick()-ai>0.1 then img(char) ai=tick() end

            if tick()-sm>0.05 then smoke(root) sm=tick() end

            task.wait(0.03)

        end

        if isDash then

            isDash=false dashAA=false

            if dashT2 then dashT2:Stop(0.1) dashT2=nil end

            if rushBV then rushBV:Destroy() rushBV=nil end

            

        end

    end)

end

if ef then ef.ChildAdded:Connect(function(obj) if not isFly then return end local function h(v) if v:IsA("BasePart") then pcall(function() v.Transparency=1 end) end if v:IsA("ParticleEmitter") or v:IsA("Trail") then pcall(function() v.Enabled=false end) end end h(obj) for _,v in ipairs(obj:GetDescendants()) do h(v) end end) end

