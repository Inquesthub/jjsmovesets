local lp = game.Players.LocalPlayer
local char = lp.Character or lp.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")
local camera = workspace.CurrentCamera
local speed = 60

hum.PlatformStand = true

local bv = Instance.new("BodyVelocity", hrp)
bv.Velocity = Vector3.new(0,0,0)
bv.MaxForce = Vector3.new(1e5,1e5,1e5)

local bg = Instance.new("BodyGyro", hrp)
bg.MaxTorque = Vector3.new(0,0,0)
bg.D = 0

local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")

local horse = Instance.new("Part")
horse.Name = "Horse"
horse.Size = Vector3.new(2, 2, 2)
horse.CanCollide = false
horse.Massless = true
horse.CFrame = torso.CFrame * CFrame.new(0, -2, 0)
horse.Parent = char

local mesh = Instance.new("SpecialMesh", horse)
mesh.MeshType = Enum.MeshType.FileMesh
mesh.MeshId = "rbxassetid://886190134"
mesh.TextureId = "rbxassetid://886190141"
mesh.Scale = Vector3.new(0.06, 0.06, 0.06)

local motor = Instance.new("Motor6D")
motor.Part0 = torso
motor.Part1 = horse
motor.C0 = CFrame.new(0, -2, 0)
motor.Parent = torso

local function getMoveVec()
    local ok, control = pcall(function()
        return require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)
    return ok and control:GetMoveVector() or Vector3.new(0,0,0)
end

game:GetService("RunService").RenderStepped:Connect(function()
    local moveVec = getMoveVec()
    if moveVec.Magnitude > 0.1 then
        local camLook = camera.CFrame.LookVector
        local camRight = camera.CFrame.RightVector
        local worldDir = camLook * -moveVec.Z + camRight * moveVec.X
        bv.Velocity = worldDir.Unit * speed
    else
        bv.Velocity = Vector3.new(0,0,0)
    end
end)
