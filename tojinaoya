local function applyDesc(char)local hum=char:WaitForChild("Humanoid")local answered=false local choice=false local cb=Instance.new("BindableFunction")cb.OnInvoke=function(btn)choice=btn=="Yes"answered=true end game:GetService("StarterGui"):SetCore("SendNotification",{Title="Switch avatar?",Text="Please confirm your choice.",Duration=15,Button1="Yes",Button2="No",Callback=cb})repeat task.wait()until answered if not choice then return end for _,v in pairs(char:GetChildren())do if v:IsA("Accessory")or v:IsA("Shirt")or v:IsA("Pants")or v:IsA("ShirtGraphic")then v:Destroy()end end pcall(function()hum.BodyTypeScale=desc.BodyTypeScale hum.BodyWidthScale=desc.WidthScale hum.BodyHeightScale=desc.HeightScale hum.BodyDepthScale=desc.DepthScale hum.HeadScale=desc.HeadScale hum.ProportionScale=desc.ProportionScale end)pcall(function()local head=char:FindFirstChild("Head")if head then local mesh=head:FindFirstChildOfClass("SpecialMesh")if mesh and desc.Head~=0 then local objs=game:GetObjects("rbxassetid://"..desc.Head)for _,obj in pairs(objs)do if obj:IsA("SpecialMesh")then mesh.MeshId=obj.MeshId mesh.TextureId=obj.TextureId mesh.Scale=obj.Scale end end end end end)local map={["Head"]=desc.HeadColor,["Torso"]=desc.TorsoColor,["Left Arm"]=desc.LeftArmColor,["Right Arm"]=desc.RightArmColor,["Left Leg"]=desc.LeftLegColor,["Right Leg"]=desc.RightLegColor}for name,color in pairs(map)do local part=char:FindFirstChild(name)if part then pcall(function()part.Color=color end)end end pcall(function()local head=char:FindFirstChild("Head")if head then local decal=head:FindFirstChild("face")if decal then decal.Texture="rbxassetid://"..desc.Face end end end)pcall(function()if desc.Shirt~=0 then local objs=game:GetObjects("rbxassetid://"..desc.Shirt)for _,obj in pairs(objs)do if obj:IsA("Shirt")then obj.Parent=char end end end end)pcall(function()if desc.Pants~=0 then local objs=game:GetObjects("rbxassetid://"..desc.Pants)for _,obj in pairs(objs)do if obj:IsA("Pants")then obj.Parent=char end end